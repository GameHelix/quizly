# Copy to .env for local runs. On Vercel these are project environment variables.

# Postgres. On Vercel the Neon integration sets it (use the pooled URL, host ending -pooler).
# Locally: a Neon branch, or `docker compose up -d` and the line below.
DATABASE_URL=postgres://quizly:quizly@localhost:5435/quizly

# Optional. The direct (unpooled) Neon URL, for migrations and for the LISTEN that tells every
# instance when a game changes. `neon env pull` and Vercel's Neon integration set it; without it,
# both use DATABASE_URL, and on Neon's pooled URL the live feeds look for changes four times a second.
DATABASE_URL_UNPOOLED=

# The admin panel and the host screen ask for this. At least 16 characters in production:
# `openssl rand -base64 24`.
ADMIN_PASSWORD=

# Signs the admin cookie. Any long random string: `openssl rand -hex 32`. Required in production.
SESSION_SECRET=

# Optional. Where the QR code sends phones. On Vercel's production deployment it defaults to the
# project's production domain. Locally it is the address the host screen was opened on, with
# "localhost" swapped for this machine's LAN address.
PUBLIC_URL=

# Optional. Express "trust proxy": set to 1 behind a TLS-terminating proxy other than Vercel.
TRUST_PROXY=

# Optional.
PORT=3000
# Players per game. Enough for the room; a cap keeps anyone from flooding a game with fake ones.
MAX_PLAYERS=100
# Optional. Database connections per process (default 5). On your own server, 10–20 for
# rooms of thousands; on Vercel leave it, as every instance has its own.
PG_POOL_MAX=
