# Copy to .env for local runs. In a container, set these in its environment.

# Postgres. Locally: `docker compose up -d` and the line below.
DATABASE_URL=postgres://quizly:quizly@localhost:5435/quizly

# Optional. A direct connection, when DATABASE_URL goes through a pooler such as PgBouncer
# (Azure's built-in one listens on 6432): migrations, and the LISTEN that tells every instance
# when a game changes, need a session of their own. Without it both use DATABASE_URL, and
# behind a pooler the live feeds look for changes four times a second instead.
DATABASE_URL_UNPOOLED=

# The admin panel and the host screen ask for this. At least 16 characters in production:
# `openssl rand -base64 24`.
ADMIN_PASSWORD=

# Signs the admin cookie. Any long random string: `openssl rand -hex 32`. Required in production.
SESSION_SECRET=

# Optional. The address phones use: what the QR code encodes and where the link preview's image
# is. Without it, the address the host screen was opened on, with "localhost" swapped for this
# machine's LAN address.
PUBLIC_URL=

# Optional. Express "trust proxy": set to 1 behind a TLS-terminating proxy (Azure Container Apps,
# nginx, Caddy), so the server sees each phone's address and that the page came over https.
TRUST_PROXY=

# Optional.
PORT=3000
# Players per game. Enough for the room; a cap keeps anyone from flooding a game with fake ones.
MAX_PLAYERS=100
# Optional. Database connections per process (default 5); 20 for rooms of thousands.
PG_POOL_MAX=
