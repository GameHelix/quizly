{
  "name": "quizly",
  "version": "1.0.0",
  "private": true,
  "description": "Live, presenter-paced quiz: a host screen, phones that join by QR code or PIN, live leaderboards. Express and Postgres, in one container.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch server/index.js",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.js",
    "test": "node --test \"test/**/*.test.js\"",
    "load-test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/load-test.js",
    "abuse-test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/abuse-test.js",
    "stress-test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/stress-test.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4"
  }
}
